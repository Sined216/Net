# Скопируйте в .env и отредактируйте перед запуском:
#   cp .env.example .env

# development | production
# В production приложение не поднимется с небезопасными настройками:
# дефолтным или коротким SECRET_KEY, пустым CORS_ORIGINS или звёздочкой в нём.
ENVIRONMENT=development

# Ключ для подписи JWT-токенов. Обязательно свой, не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Срок жизни токена в минутах (по умолчанию 12 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Адреса, с которых открывается интерфейс, через запятую.
# Звёздочка допустима только в development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Подключение к базе. В docker compose подставляется автоматически,
# менять нужно только при запуске без Docker.
# DATABASE_URL=postgresql://netdoc:netdoc@localhost:5432/netdoc

# Пароль пользователя PostgreSQL, поднимаемого в docker compose
POSTGRES_PASSWORD=netdoc

# Учётные данные администратора, создаваемого при первом запуске.
# Используются только пока в базе нет ни одного пользователя.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
