{
  "name": "wiremap-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform android --no-bytecode --output-dir /tmp/wiremap-bundle",
    "codegen": "npx --yes openapi-typescript@^7.13.0 ../backend/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "^57.0.16",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "babel-preset-expo": "^57.0.8",
    "typescript": "~6.0.2"
  }
}
